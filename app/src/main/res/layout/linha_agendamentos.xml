<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        android:orientation="vertical"
        android:paddingTop="10sp"
        android:paddingBottom="10sp"
        tools:layout_editor_absoluteX="5dp">

        <TextView
            android:id="@+id/linhaAgen_txtHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/googlesansflex"
            android:paddingStart="5sp"
            android:text="9:50"
            android:textColor="@color/black"
            android:textFontWeight="400"
            android:textSize="30sp" />

        <LinearLayout
            android:id="@+id/borda_conteudo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/border"
            android:orientation="vertical"
            android:padding="15sp">

            <LinearLayout
                android:id="@+id/conteudo_agendamento"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/linhaAgen_PetNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/googlesansflex"
                        android:text="Luke"
                        android:textColor="@color/black"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/linhaAgen_PetExtra"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/googlesansflex"
                        android:text="Cachorro - Yorkshire"
                        android:textColor="#8A8A8A"
                        android:textSize="15sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/linhaAgen_ServicoNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/box_agen"
                    android:fontFamily="@font/googlesansflex"
                    android:gravity="center"
                    android:padding="2sp"
                    android:text="Ajuste de rosto e orelhas"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>